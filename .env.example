# ==========================================
# SupportIQ Environment Configuration
# ==========================================

# Environment Mode: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & JWT Authentication
SECRET_KEY=change-this-to-a-super-secret-cryptographic-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL with pgvector for production; SQLite supported for local lightweight testing)
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./backend/app/supportiq.db
# Docker / Postgres default:
# DATABASE_URL=postgresql+asyncpg://supportiq:supportiq_secret_password@localhost:5432/supportiq

# Redis Cache & Celery Task Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI Foundation Models API Keys
OPENAI_API_KEY=your-openai-api-key-here
# Optional additional providers:
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here

# RAG & Embedding Settings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
TOP_K_CHUNKS=4

# Rate Limiting (Requests per minute)
RATE_LIMIT_UNAUTHENTICATED=20
RATE_LIMIT_AUTHENTICATED=60
RATE_LIMIT_AI_CHAT=10

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend Variables (Vite)
VITE_API_URL=/api/v1
